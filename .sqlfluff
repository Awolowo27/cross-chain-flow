[sqlfluff]
dialect = bigquery
templater = dbt
max_line_length = 200

# Focus on SQL structural & syntax errors, ignoring layout and style rules
exclude_rules = layout.indent, layout.long_lines, layout.spacing, layout.newlines, layout.end_of_file, layout.cte_newline, capitalisation.keywords, capitalisation.identifiers, capitalisation.functions, references.qualification, convention.left_join, aliasing.table, aliasing.self_alias.column, structure.column_order

[sqlfluff:templater:dbt]
profiles_dir = .
profile = cross_chain_fund
target = dev
manifest_path = target/manifest.json
